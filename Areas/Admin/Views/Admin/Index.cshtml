@model List<DonHang>
@using ResipWeb.Models
@using System.Linq
@{
    ViewData["Title"] = "Bảng điều khiển";

    decimal totalRevenue = ((decimal?)(ViewBag.TotalRevenue ?? 0) ?? 0) / 100;
    int totalOrders = (int)(ViewBag.OrderCount ?? 0);

    // ✅ Cast về List<TopCategoryViewModel> - public class nên View có thể truy cập
    var topCategories = (ViewBag.TopCategories as List<TopCategoryViewModel>) ?? new List<TopCategoryViewModel>();
    int totalProducts = (int)(ViewBag.TotalProductsInCategories ?? 0);
    bool hasCategories = topCategories.Any();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --primary: #3b82f6;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --purple: #8b5cf6;
        --bg-gray: #f8fafc;
        --text-main: #1e293b;
        --text-muted: #64748b
    }

    body {
        margin: 0
    }

    .dashboard-container {
        padding: 30px;
        background: var(--bg-gray);
        min-height: 100vh;
        font-family: 'Inter',sans-serif
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 20px;
        margin-bottom: 30px
    }

    .stat-card {
        background: #fff;
        padding: 20px;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        transition: .2s;
        text-decoration: none !important
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,.05)
        }

    .stat-label {
        font-size: 13px;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between
    }

    .stat-value {
        font-size: 26px;
        font-weight: 800;
        color: var(--text-main)
    }

    .main-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 24px
    }

    .panel-card {
        background: #fff;
        padding: 24px;
        border-radius: 20px;
        border: 1px solid #e2e8f0
    }

    /* Progress bars */
    .category-item {
        margin-bottom: 18px
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        font-weight: 600;
        margin-bottom: 6px
    }

    .progress-bar-bg {
        height: 10px;
        background: #e2e8f0;
        border-radius: 50px;
        overflow: hidden
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 50px;
        background: linear-gradient(90deg,#3b82f6,#6366f1);
        transition: width .4s ease
    }

    .action-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px
    }

    .btn-quick {
        background: #f1f5f9;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        text-decoration: none;
        color: var(--text-main);
        font-weight: 600;
        font-size: 14px;
        transition: .2s
    }

        .btn-quick:hover {
            background: var(--primary);
            color: #fff
        }

        .btn-quick i {
            display: block;
            font-size: 20px;
            margin-bottom: 5px
        }

    @@media(max-width:992px) {
        .main-grid {
            grid-template-columns: 1fr
        }
    }
</style>

<div class="dashboard-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
    <h3 class="fw-bold m-0">Bảng điều khiển quản trị</h3>
    <p class="text-muted small m-0">
        <i class="fa-regular fa-clock me-1"></i> 
        Dữ liệu thời gian thực | <span id="current-time">Đang tải...</span>
    </p>
</div>
        <button class="btn btn-white border shadow-sm rounded-pill px-3" onclick="location.reload()">
            <i class="fa-solid fa-sync-alt me-2"></i>Làm mới
        </button>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Doanh thu <i class="fa-solid fa-wallet text-success"></i></div>
            <div class="stat-value">@totalRevenue.ToString("N0") đ</div>
        </div>

        <a href="/Admin/DonHangs" class="stat-card">
            <div class="stat-label">Đơn hàng <i class="fa-solid fa-shopping-bag text-primary"></i></div>
            <div class="stat-value">@totalOrders</div>
        </a>

        <a href="/Admin/SanPham" class="stat-card">
            <div class="stat-label">Kho hàng <i class="fa-solid fa-box text-purple"></i></div>
            <div class="stat-value">@ViewBag.ActiveProducts/@ViewBag.ProductCount</div>
        </a>

        <div class="stat-card">
            <div class="stat-label">Người dùng <i class="fa-solid fa-users text-warning"></i></div>
            <div class="stat-value">@ViewBag.TotalUsers</div>
        </div>
    </div>

    <div class="main-grid">
        <!-- THAY CHART = PROGRESS BARS -->
        <div class="panel-card">
            <h5 class="fw-bold mb-4">
                <i class="fa-solid fa-chart-simple me-2 text-primary"></i>
                Phân bổ sản phẩm theo danh mục
            </h5>

            @if (!hasCategories)
            {
                <p class="text-muted">Chưa có dữ liệu danh mục.</p>
            }
            else
            {
                foreach (var item in topCategories)
                {
                    var count = item.ProductCount;
                    var categoryName = item.CategoryName;
                    var percent = totalProducts == 0 ? 0 : (count * 100 / totalProducts);

                    <div class="category-item">
                        <div class="category-header">
                            <span>@categoryName</span>
                            <span>@count sản phẩm (@percent%)</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill" style="width:@percent%"></div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- RIGHT SIDE -->
        <div class="d-flex flex-column gap-3">
            <div class="panel-card">
                <h5 class="fw-bold mb-3">Thao tác nhanh</h5>
                <div class="action-grid">
                    <a href="/Admin/SanPham/Create" class="btn-quick"><i class="fa-solid fa-plus-circle"></i>Thêm SP</a>
                    <a href="/Admin/DonHangs" class="btn-quick"><i class="fa-solid fa-list-check"></i>Đơn hàng</a>
                    <a href="/Admin/Users" class="btn-quick"><i class="fa-solid fa-user-cog"></i>Thành viên</a>
                    <a href="/Admin/VnPayTransactions" class="btn-quick"><i class="fa-solid fa-history"></i>Giao dịch</a>
                </div>
            </div>

            <div class="panel-card border-0" style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white;">
                <h6 class="fw-bold mb-2">
                    <i class="fa-solid fa-info-circle me-2"></i>Lưu ý quản trị
                </h6>
                <p class="small m-0 opacity-75">
                    Hệ thống ghi nhận doanh thu dựa trên các đơn hàng đã chuyển trạng thái <b>"Hoàn thành"</b>.
                    Vui lòng kiểm tra đối soát VNPAY định kỳ.
                </p>
            </div>
        </div>
    </div>
</div>
<script>
    function updateClock() {
        const now = new Date();
        const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];

        const dayName = days[now.getDay()];
        const date = String(now.getDate()).padStart(2, '0');
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const year = now.getFullYear();

        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');

        // Định dạng: Thứ Hai, 18/02/2026 18:05:30
        const timeString = `${dayName}, ${date}/${month}/${year} ${hours}:${minutes}:${seconds}`;

        document.getElementById('current-time').innerText = timeString;
    }

    // Chạy đồng hồ ngay lập tức và cập nhật mỗi giây
    setInterval(updateClock, 1000);
    updateClock();
</script>