
@{
    ViewData["Title"] = "Kết quả thanh toán VNPAY";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // VNPAY query params
    var txnRef = Context.Request.Query["vnp_TxnRef"].ToString();
    var responseCode = Context.Request.Query["vnp_ResponseCode"].ToString();
    var transactionNo = Context.Request.Query["vnp_TransactionNo"].ToString();
    var amountStr = Context.Request.Query["vnp_Amount"].ToString(); // *100
    var orderInfo = Context.Request.Query["vnp_OrderInfo"].ToString();
    var bankCode = Context.Request.Query["vnp_BankCode"].ToString();
    var payDate = Context.Request.Query["vnp_PayDate"].ToString();
    var secureHash = Context.Request.Query["vnp_SecureHash"].ToString();

    // Controller đang set: ViewBag.IsValidSignature
    bool isValidSignature = (ViewBag.IsValidSignature as bool?) ?? false;

    bool isSuccess = responseCode == "00" && isValidSignature;

    string statusIcon = isSuccess ? "✓" : "✕";
    string statusClass = isSuccess ? "success" : "error";
    string statusTitle = isSuccess ? "Thanh toán thành công!" : "Thanh toán thất bại!";
    string statusMessage = isSuccess
        ? "Cảm ơn bạn đã mua hàng. Đơn hàng của bạn đang được xử lý."
        : (!isValidSignature ? "Chữ ký không hợp lệ. Vui lòng liên hệ hỗ trợ." : "Giao dịch không thành công. Vui lòng thử lại.");

    string FormatCurrencyFromVnp(string vnpAmount)
    {
        if (long.TryParse(vnpAmount, out var v))
        {
            // VNPAY amount = VND * 100
            var real = v / 100;
            return string.Format("{0:N0} ₫", real);
        }
        return vnpAmount;
    }

    string FormatPayDate(string raw)
    {
        // yyyyMMddHHmmss
        if (DateTime.TryParseExact(raw, "yyyyMMddHHmmss", null, System.Globalization.DateTimeStyles.None, out var dt))
            return dt.ToString("dd/MM/yyyy HH:mm:ss");
        return raw;
    }
}

<style>
    .payment-result-section {
        background: #fff;
        padding: 60px 20px;
        min-height: 600px;
    }

    .payment-container {
        max-width: 700px;
        margin: 0 auto;
    }

    .payment-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        overflow: hidden;
        border: 1px solid #e9ecef;
    }

    .payment-header {
        padding: 50px 30px;
        text-align: center;
    }

        .payment-header.success {
            background: linear-gradient(135deg,#11998e 0%,#38ef7d 100%);
        }

        .payment-header.error {
            background: linear-gradient(135deg,#eb3349 0%,#f45c43 100%);
        }

    .status-icon-circle {
        width: 100px;
        height: 100px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        font-size: 60px;
        font-weight: 700;
    }

        .status-icon-circle.success {
            color: #11998e;
        }

        .status-icon-circle.error {
            color: #eb3349;
        }

    .payment-status-title {
        color: #fff;
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 10px;
    }

    .payment-status-subtitle {
        color: rgba(255,255,255,.95);
        font-size: 16px;
        margin: 0;
    }

    .payment-content {
        padding: 45px 35px;
    }

    .order-details {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 30px;
        border: 1px solid #e9ecef;
        margin-bottom: 30px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 0;
        border-bottom: 1px solid #dee2e6;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #6c757d;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .detail-value {
        color: #212529;
        font-size: 15px;
        font-weight: 600;
        text-align: right;
        word-break: break-word;
    }

    .badge {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
    }

        .badge.success {
            background: #d4edda;
            color: #155724;
            border: 2px solid #c3e6cb;
        }

        .badge.error {
            background: #f8d7da;
            color: #721c24;
            border: 2px solid #f5c6cb;
        }

    .payment-actions {
        display: flex;
        gap: 12px;
    }

    .btnx {
        flex: 1;
        padding: 14px 18px;
        border-radius: 10px;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .btn-primary {
        background: #0d6efd;
        color: #fff;
    }

    .btn-outline {
        border: 2px solid #0d6efd;
        color: #0d6efd;
        background: #fff;
    }

    .brand {
        text-align: center;
        padding: 22px;
        border-top: 1px solid #f1f3f5;
    }

        .brand img {
            height: 34px;
        }

    @@media (max-width:768px) {
        .payment-content {
            padding: 28px 18px;
        }

        .payment-actions {
            flex-direction: column;
        }
    }
</style>

<div class="payment-result-section">
    <div class="payment-container">
        <div class="payment-card">
            <div class="payment-header @statusClass">
                <div class="status-icon-circle @statusClass">@statusIcon</div>
                <h1 class="payment-status-title">@statusTitle</h1>
                <p class="payment-status-subtitle">@statusMessage</p>
            </div>

            <div class="payment-content">
                <div class="order-details">
                    <div class="detail-row">
                        <span class="detail-label">Mã tham chiếu (TxnRef)</span>
                        <span class="detail-value">@txnRef</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Mã GD VNPAY</span>
                        <span class="detail-value">@transactionNo</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Số tiền</span>
                        <span class="detail-value" style="color:#005baa;font-size:18px;font-weight:900;">
                            @FormatCurrencyFromVnp(amountStr)
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Ngân hàng</span>
                        <span class="detail-value">@bankCode</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Thời gian</span>
                        <span class="detail-value">@FormatPayDate(payDate)</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Nội dung</span>
                        <span class="detail-value">@orderInfo</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Trạng thái</span>
                        <span class="badge @statusClass">@((isSuccess) ? "✓ Thành công" : "✕ Thất bại")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Chữ ký</span>
                        <span class="detail-value">@((isValidSignature) ? "Hợp lệ" : "Không hợp lệ")</span>
                    </div>
                </div>

                <div class="payment-actions">
                    <a href="/" class="btnx btn-primary">Về trang chủ</a>
                    @if (isSuccess)
                    {
                        <a href="/LichSuDonHang" class="btnx btn-outline">Xem đơn hàng</a>
                    }
                    else
                    {
                        <a href="/Cart" class="btnx btn-outline">Thử lại</a>
                    }
                </div>
            </div>

            <div class="brand">
                <div style="font-size:12px;color:#adb5bd;font-weight:800;letter-spacing:1px;margin-bottom:10px;">THANH TOÁN QUA</div>
                <img src="/assets/logopay/vnpay-logo.jpg" alt="VNPAY" />
            </div>
        </div>
    </div>
</div>