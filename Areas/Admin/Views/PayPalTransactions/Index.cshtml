@model List<ResipWeb.Models.Payments.PayPalTransaction>
@using System

@{
    ViewData["Title"] = "Quản lý giao dịch PayPal";

    string q = ViewBag.Q as string ?? "";
    string status = ViewBag.Status as string ?? "";

    int currentPage = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 30;
    int total = ViewBag.Total ?? 0;
    int totalPages = (int)Math.Ceiling(total / (double)pageSize);

    string paypalBlue = "#003087";

    // ====== CHART DATA (0 JS) ======
    int successCount = ViewBag.SuccessCount ?? 0;
    int failCount = ViewBag.FailCount ?? 0;

    double successPercent = total <= 0 ? 0 : (successCount * 100.0 / total);
    double failPercent = total <= 0 ? 0 : (failCount * 100.0 / total);
}

<style>
    :root { --paypal-blue: @paypalBlue; }

    .bg-paypal { background-color: var(--paypal-blue) !important; color: #fff; }
    .text-paypal { color: var(--paypal-blue) !important; }
    .btn-paypal { background: var(--paypal-blue); border-color: var(--paypal-blue); color: #fff; }
    .btn-paypal:hover { background: #001c4f; border-color: #001c4f; color: #fff; }

    .card { border: none; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.075); border-radius: 0.75rem; }
    .table thead { background: #f8f9fa; }
    .badge-pill { padding: .4em .8em; border-radius: 999px; font-weight: 500; font-size: .85rem; }
    .form-control:focus, .form-select:focus { border-color: var(--paypal-blue); box-shadow: 0 0 0 .2rem rgba(0, 48, 135, .25); }
    .font-monospace { font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: .9em; }

    /* ====== LIGHT CHART (NO JS) ====== */
    .summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    @@media (max-width: 992px) {
        .summary-grid { grid-template-columns: 1fr; }
    }

    .donut-wrap{
        display:flex; align-items:center; gap:16px;
    }
    .donut{
        width:120px; height:120px; border-radius:50%;
        background: conic-gradient(#198754 @successPercent%, #dc3545 0);
        position: relative;
        flex: 0 0 auto;
    }
    .donut::after{
        content:"";
        position:absolute;
        inset: 14px;
        background:#fff;
        border-radius:50%;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,.06);
    }
    .donut-center{
        position:absolute;
        inset:0;
        display:flex;
        align-items:center;
        justify-content:center;
        font-weight:800;
        color:#111827;
        z-index:2;
        flex-direction:column;
        line-height:1.1;
    }
    .donut-center small{ font-weight:600; color:#6b7280; }

    .bar{
        height: 16px;
        border-radius: 999px;
        overflow:hidden;
        background:#e9ecef;
    }
    .bar > .ok{ height:100%; float:left; background:#198754; width:@successPercent%; }
    .bar > .fail{ height:100%; float:left; background:#dc3545; width:@failPercent%; }

    .kpi{
        display:flex; gap:10px; flex-wrap:wrap;
        font-size: .9rem;
    }
    .kpi .dot{
        width:10px; height:10px; border-radius:50%;
        display:inline-block; margin-right:6px;
    }
</style>

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <div class="bg-paypal p-2 rounded-3 me-3">
            <i class="bi bi-paypal fs-3"></i>
        </div>
        <div>
            <h3 class="fw-bold mb-0">Lịch sử giao dịch PayPal</h3>
            <p class="text-muted mb-0">Tra cứu và đối soát dữ liệu thanh toán qua cổng quốc tế PayPal</p>
        </div>
    </div>

    <!-- Filter -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3">
                <div class="col-lg-5">
                    <label class="form-label small fw-bold text-uppercase text-muted">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input class="form-control bg-light border-start-0" name="q" value="@q" placeholder="Mã đơn, PayPalOrderId, Email..." />
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-uppercase text-muted">Trạng thái</label>
                    <select class="form-select bg-light" name="status">
                        <option value="">Tất cả</option>
                        <option value="COMPLETED" selected="@(status=="COMPLETED")">Hoàn tất (Completed)</option>
                        <option value="FAILED" selected="@(status=="FAILED")">Thất bại (Failed)</option>
                    </select>
                </div>

                <div class="col-lg-1 col-md-6">
                    <label class="form-label small fw-bold text-uppercase text-muted">Hiển thị</label>
                    <select class="form-select bg-light" name="pageSize">
                        <option value="30" selected="@(pageSize==30)">30</option>
                        <option value="50" selected="@(pageSize==50)">50</option>
                    </select>
                </div>

                <div class="col-lg-3 d-flex align-items-end gap-2">
                    <button class="btn btn-paypal flex-grow-1" type="submit">
                        <i class="bi bi-filter me-1"></i> Lọc kết quả
                    </button>
                    <a class="btn btn-outline-secondary" href="@Url.Action("Index", "PayPalTransactions", new { area = "Admin" })">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- SUMMARY CHART -->
    <div class="card mb-4">
        <div class="card-body p-4">
            <div class="summary-grid">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="fw-bold text-paypal">Tổng quan trạng thái</div>
                        <div class="small text-muted">Tổng: <b>@total</b> giao dịch</div>
                    </div>

                    <div class="bar mb-2">
                        <div class="ok"></div>
                        <div class="fail"></div>
                    </div>

                    <div class="kpi">
                        <span><span class="dot" style="background:#198754;"></span>Hoàn tất: <b>@successCount</b> (@successPercent.ToString("0.0")%)</span>
                        <span><span class="dot" style="background:#dc3545;"></span>Thất bại/Lỗi: <b>@failCount</b> (@failPercent.ToString("0.0")%)</span>
                    </div>
                </div>

                <div class="donut-wrap">
                    <div class="donut">
                        <div class="donut-center">
                            <div>@successPercent.ToString("0")%</div>
                            <small>OK</small>
                        </div>
                    </div>

                    <div>
                        <div class="fw-bold mb-1">Tỷ lệ thành công</div>
                        <div class="text-muted small mb-2">Dựa trên bộ lọc hiện tại.</div>
                        <div class="small">
                            <div><b class="text-success">@successCount</b> giao dịch hoàn tất</div>
                            <div><b class="text-danger">@failCount</b> giao dịch lỗi</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Thời gian</th>
                            <th>Thông tin đơn</th>
                            <th>Người mua</th>
                            <th class="text-end">Số tiền (USD)</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy giao dịch PayPal nào
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var x in Model)
                            {
                                var isSuccess = x.Status == "COMPLETED";
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">@x.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        <div class="small text-muted">@x.CreatedAt.ToString("HH:mm:ss")</div>
                                    </td>
                                    <td>
                                        <div class="mb-1">
                                            <span class="text-muted small">Mã đơn:</span>
                                            <span class="fw-bold font-monospace">@x.OrderId</span>
                                        </div>
                                        <div>
                                            <span class="text-muted small">Capture ID:</span>
                                            <span class="text-secondary small font-monospace">@x.PayPalOrderId</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@x.PayerEmail</div>
                                        <div class="small text-muted font-monospace">@x.PayerID</div>
                                    </td>
                                    <td class="text-end fw-bold text-paypal">
                                        $@x.AmountUsd
                                    </td>
                                    <td class="text-center">
                                        @if (isSuccess)
                                        {
                                            <span class="badge badge-pill bg-success-subtle text-success border border-success">
                                                <i class="bi bi-check-circle-fill me-1"></i> @x.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pill bg-danger-subtle text-danger border border-danger">
                                                <i class="bi bi-x-circle-fill me-1"></i> @x.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                           asp-area="Admin" asp-controller="PayPalTransactions"
                                           asp-action="Details" asp-route-id="@x.Id">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white py-3">
                <div class="row align-items-center">
                    <div class="col-md-6 text-muted small">
                        Hiển thị trang <b>@currentPage</b> / <b>@totalPages</b> (Tổng <b>@total</b> giao dịch)
                    </div>
                    <div class="col-md-6">
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm justify-content-end mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="?q=@q&status=@status&page=@(currentPage-1)&pageSize=@pageSize">Trước</a>
                                </li>

                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link @(i == currentPage ? "bg-paypal" : "text-paypal")"
                                           href="?q=@q&status=@status&page=@i&pageSize=@pageSize">@i</a>
                                    </li>
                                }

                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link text-paypal" href="?q=@q&status=@status&page=@(currentPage+1)&pageSize=@pageSize">Tiếp</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
