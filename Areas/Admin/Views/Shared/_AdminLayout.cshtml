@inject ResipWeb.Models.AppDbContext _context
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache _cache
@using Microsoft.Extensions.Caching.Memory
@{
    // ✅ CACHE WebsiteSettings để tránh query database trên mỗi request
    const string CACHE_KEY = "WebsiteSetting";
    ResipWeb.Models.WebsiteSetting? setting = null;
    
    if (!_cache.TryGetValue<ResipWeb.Models.WebsiteSetting>(CACHE_KEY, out setting) || setting == null)
    {
        setting = _context.WebsiteSettings.FirstOrDefault() ?? new ResipWeb.Models.WebsiteSetting();
        var cacheOptions = new MemoryCacheEntryOptions
        {
            AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(30),
            SlidingExpiration = TimeSpan.FromMinutes(10)
        };
        using (var entry = _cache.CreateEntry(CACHE_KEY))
        {
            entry.Value = setting;
            entry.SetOptions(cacheOptions);
        }
    }
    
    // Đảm bảo setting không null trước khi sử dụng
    var websiteSetting = setting ?? new ResipWeb.Models.WebsiteSetting();
}


