@model ResipWeb.Models.Payments.MomoTransaction

@{
    ViewData["Title"] = "Chi tiết giao dịch MoMo";
    string mainColor = "#28a745";
}

<style>
    :root {
        --momo-green: @mainColor;
    }

    .text-momo {
        color: var(--momo-green);
    }

    .bg-momo {
        background-color: var(--momo-green);
        color: white;
    }

    /* Mở rộng toàn màn hình */
    .transaction-card {
        border: 1px solid #e9ecef;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        width: 100%; /* Chiếm hết chiều rộng cho phép */
        margin-bottom: 2rem;
    }

    .tr-header {
        padding: 1.5rem 2rem;
        background: #f8f9fa;
        border-bottom: 1px dashed #dee2e6;
    }

    /* Tối ưu lại label/value để dàn hàng ngang tốt hơn */
    .info-group {
        margin-bottom: 1.25rem;
    }

    .info-label {
        font-size: 0.7rem;
        color: #888;
        text-transform: uppercase;
        font-weight: 700;
        display: block;
        margin-bottom: 4px;
    }

    .info-value {
        font-weight: 600;
        color: #212529;
        font-size: 0.95rem;
    }

    /* Bảng kỹ thuật rộng rãi */
    .tech-table {
        font-size: 0.85rem;
        margin-top: 1rem;
        width: 100%;
    }

        .tech-table th {
            color: #6c757d;
            font-weight: 600;
            width: 15%;
            background: #fbfbfb;
            vertical-align: middle;
        }

    .signature-wrap {
        word-break: break-all;
        font-family: font-monospace;
        color: #666;
        background: #f1f3f5;
        padding: 8px 12px;
        border-radius: 4px;
        display: block;
    }
</style>

<div class="container-fluid py-3 px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="/Admin/MomoTransactions" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-sm btn-light border">
                <i class="bi bi-printer"></i> In đơn hàng
            </button>
        </div>
    </div>

    <div class="transaction-card shadow-sm">
        <div class="tr-header">
            <div class="row align-items-center">
                <div class="col-lg-8 col-md-7">
                    <div class="d-flex align-items-center gap-3">
                        <h3 class="fw-bold mb-0">Giao dịch #@Model.Id</h3>
                        @if (Model.ResultCode == 0)
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                <i class="bi bi-check-circle-fill"></i> THÀNH CÔNG
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger px-3 py-2 rounded-pill">
                                <i class="bi bi-x-circle-fill"></i> THẤT BẠI
                            </span>
                        }
                    </div>
                    <p class="text-muted mt-2 mb-0">
                        <i class="bi bi-clock"></i> Khởi tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")
                        <span class="mx-2">|</span>
                        <i class="bi bi-fingerprint"></i> Partner: @Model.PartnerCode
                    </p>
                </div>
                <div class="col-lg-4 col-md-5 text-md-end mt-3 mt-md-0">
                    <div class="p-3 bg-momo rounded-3 d-inline-block text-end shadow-sm" style="min-width: 280px;">
                        <span class="small opacity-75 d-block text-uppercase fw-bold">Tổng thanh toán</span>
                        <h2 class="fw-bold mb-0">@Model.Amount.ToString("#,##0") đ</h2>
                        <div class="small mt-1"><i class="bi bi-shield-check"></i> MoMo Payment Gateway</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-xl-3 col-md-6 border-end">
                    <div class="info-group">
                        <span class="info-label">Mã đơn hàng (OrderId)</span>
                        <div class="info-value text-primary fs-5">@Model.OrderId</div>
                    </div>
                    <div class="info-group">
                        <span class="info-label">Mã yêu cầu (RequestId)</span>
                        <div class="info-value small text-muted">@Model.RequestId</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 border-end ps-xl-4">
                    <div class="info-group">
                        <span class="info-label">Nội dung đơn hàng</span>
                        <div class="info-value">@Model.OrderInfo</div>
                    </div>
                    <div class="info-group">
                        <span class="info-label">Phương thức</span>
                        <div class="info-value">
                            <span class="badge bg-info text-dark">@Model.PayType</span>
                            <span class="badge bg-secondary ms-1">@Model.Source</span>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 border-end ps-xl-4">
                    <div class="info-group">
                        <span class="info-label">Mã giao dịch MoMo (TransId)</span>
                        <div class="info-value">@Model.TransId</div>
                    </div>
                    <div class="info-group">
                        <span class="info-label">Trạng thái từ Gateway</span>
                        <div class="info-value @(Model.ResultCode == 0 ? "text-success" : "text-danger")">
                            <i class="bi bi-info-circle me-1"></i> @Model.Message
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 ps-xl-4">
                    <div class="info-group">
                        <span class="info-label">Thời gian phản hồi</span>
                        <div class="info-value">@Model.ResponseTime</div>
                    </div>
                    <div class="info-group">
                        <span class="info-label">Loại đơn hàng</span>
                        <div class="info-value">@Model.OrderType</div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-4 border-top">
                <h6 class="fw-bold text-momo mb-3 align-items-center d-flex">
                    <i class="bi bi-cpu fs-5 me-2"></i> Thông số kỹ thuật hệ thống
                </h6>
                <div class="table-responsive">
                    <table class="table table-bordered tech-table mb-0">
                        <tbody>
                            <tr>
                                <th>Signature</th>
                                <td class="p-0">
                                    <code class="signature-wrap">@Model.Signature</code>
                                </td>
                            </tr>
                            <tr>
                                <th>Extra Data</th>
                                <td>
                                    <span class="text-muted">@(string.IsNullOrEmpty(Model.ExtraData) ? "Không có dữ liệu bổ sung" : Model.ExtraData)</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="bg-light p-3 px-4 d-flex gap-2 justify-content-end">
            @if (Model.ResultCode == 0)
            {
                
            }
            <button class="btn btn-dark">
                <i class="bi bi-envelope me-1"></i> Gửi hóa đơn Email
            </button>
        </div>
    </div>
</div>